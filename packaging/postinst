#!/bin/sh
set -e

# Reload udev rules so Audient audio interfaces are accessible without root permissions
if [ -x "$(command -v udevadm)" ]; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=usb || true
fi

# Remove legacy desktop entry if upgrading
rm -f /usr/share/applications/id-mixer.desktop

# Update desktop application database
if [ -x "$(command -v update-desktop-database)" ]; then
    update-desktop-database -q /usr/share/applications || true
fi

# Update icon theme cache
if [ -x "$(command -v gtk-update-icon-cache)" ]; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

exit 0
